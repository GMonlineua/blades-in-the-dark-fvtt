{
  "devDependencies": {
    "js-beautify": "^1.15.4",
    "prettier": "^3.8.4",
    "prettier-plugin-css-order": "^2.2.0",
    "sass": "^1.101.0"
  },
  "dependencies": {
    "node": "^26.3.0"
  },
  "scripts": {
    "build:css": "sass --load-path scss --style compressed scss/bitd.scss css/bitd.css",
    "watch:css": "sass --load-path scss --style compressed -w scss/bitd.scss css/bitd.css",
    "format:assets": "prettier --write \"**/*.{mjs,js,json,scss}\"",
    "format:hbs": "html-beautify -r \"**/*.hbs\"",
    "format": "npm run format:assets && npm run format:hbs"
  },
  "version": "0.0.1"
}
